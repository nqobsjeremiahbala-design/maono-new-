# ─── Database ────────────────────────────────────────────────
# Docker dev (default — docker-compose overrides this):
DATABASE_URL="postgresql://maono:maono_dev@localhost:5432/maono?schema=public"
# For local dev, set DIRECT_URL to same as DATABASE_URL:
DIRECT_URL="postgresql://maono:maono_dev@localhost:5432/maono?schema=public"
# Supabase direct connection (for migrations):
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
# Supabase pooler (for app runtime):
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase direct (for Prisma migrations — same as above but port 5432, no pgbouncer):
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─── Auth (NextAuth.js v5 / Auth.js) ────────────────────────
# Generate with: npx auth secret
AUTH_SECRET="replace-with-generated-secret"
# Optional: OAuth providers
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ─── Ozow Payment Gateway ───────────────────────────────────
# https://ozow.com — SA instant EFT + card payments
OZOW_SITE_CODE=""
OZOW_PRIVATE_KEY=""
OZOW_API_KEY=""
OZOW_IS_TEST="true"       # set "false" in production

# ─── Netcash Pay Now (eCommerce) ─────────────────────────────
# Server-side only — never exposed to the browser.
# ⚠️ PLACEHOLDER: fill NETCASH_SERVICE_KEY per environment before deploying.
NETCASH_SERVICE_KEY=""                 # Pay Now service key (staging key on staging, live key on prod)
NETCASH_VENDOR_KEY=""                  # optional; defaults to Netcash ISV key 24ade73c-98cf-47b3-99be-cc7b867b3080
NETCASH_TEST_MODE="true"               # "false" in production
# Base URL of THIS deployment — Netcash portal postback URLs must point here:
#   {NEXT_PUBLIC_BASE_URL}/api/payments/netcash/notify   (Notify — fulfillment)
#   {NEXT_PUBLIC_BASE_URL}/api/payments/netcash/accept   (Accept — UI)
#   {NEXT_PUBLIC_BASE_URL}/api/payments/netcash/decline  (Decline — UI)
#   {NEXT_PUBLIC_BASE_URL}/api/payments/netcash/redirect (Redirect — pending/offline)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ─── Go-live gate (registration + checkout) ──────────────────
# false = closed (existing-clients-only). Set true on STAGING for UAT, and on
# PRODUCTION only at go-live. Opens the Register button + Netcash checkout.
NEXT_PUBLIC_ENROLLMENT_OPEN="false"

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Admin seed (used by prisma/seed.ts) ─────────────────────
# Required — seed throws if ADMIN_PASSWORD is missing or < 12 chars.
# Generate a strong password: openssl rand -base64 24
ADMIN_EMAIL="admin@maonoforextrading.co.za"
ADMIN_PASSWORD=""

# ─── Analytics ────────────────────────────────────────────────
# Set to a real GA4 measurement ID (e.g. "G-ABC123XYZ") to enable analytics.
# Leave empty in dev to disable.
NEXT_PUBLIC_GA_ID=""

# ─── Supabase (for deployment script) ───────────────────────
# SUPABASE_PROJECT_REF=""
# SUPABASE_DB_PASSWORD=""
# SUPABASE_ACCESS_TOKEN=""

# ─── Video Storage (future) ──────────────────────────────────
# Option A: Vercel Blob
# BLOB_READ_WRITE_TOKEN=""
# Option B: Mux
# MUX_TOKEN_ID=""
# MUX_TOKEN_SECRET=""
