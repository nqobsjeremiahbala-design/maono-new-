{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maono-new",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  // nodejs_compat is required by the OpenNext adapter (Prisma pg driver, bcryptjs, crypto, etc.)
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },

  // ─── R2: video / media storage (admin upload route) ──────────────────────
  // Bucket is created with: wrangler r2 bucket create maono-media
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "maono-media"
    }
  ],

  // ─── Hyperdrive: Postgres (Supabase session pooler) ──────────────────────
  // Created via: wrangler hyperdrive create maono-db --connection-string=... --caching-disabled
  // For `next dev` / `wrangler dev`, set
  // WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE in .dev.vars.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "cf503cb8448a455d8c64fb69d3081df8",
      // Placeholder only — used by wrangler's local emulation so `wrangler deploy`
      // (OpenNext) doesn't error in CI. Production uses the real DB via the `id` above;
      // local dev overrides this via CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
      "localConnectionString": "postgresql://placeholder:placeholder@localhost:5432/placeholder"
    }
  ]
}
