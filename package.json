{
  "name": "maono-global-forex",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/patch-pg-cloudflare.mjs && node scripts/gen-content.mjs",
    "gen:content": "node scripts/gen-content.mjs",
    "cf:build": "node scripts/patch-pg-cloudflare.mjs && node scripts/gen-content.mjs && wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up --build",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "deploy:supabase": "./scripts/deploy-supabase.sh",
    "db:migrate:wp": "WP_DUMP=$WP_DUMP npx tsx scripts/migrate-wordpress.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.4",
    "@opennextjs/cloudflare": "^1.19.11",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "gray-matter": "^4.0.3",
    "next": "^16.2.7",
    "next-auth": "^5.0.0-beta.31",
    "next-mdx-remote": "^6.0.0",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "mysql2": "^3.22.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "wrangler": "^4.98.0"
  }
}
